# ========================================
# MESSAGING & CALLING SDK - Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# For development, you can use the placeholder values below

# ========================================
# REQUIRED SETTINGS (Must be configured)
# ========================================

# Database - PostgreSQL connection
# For local development with Docker:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/messaging_db
# For production/cloud:
# DATABASE_URL=postgresql+asyncpg://username:password@hostname:5432/database_name

# Security - Generate a strong random key (64+ characters)
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-64-characters-long

# ========================================
# AUTHENTICATION (Google OAuth)
# ========================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ========================================
# EMAIL CONFIGURATION (Choose ONE provider)
# ========================================

# Option 1: Resend (Recommended for development - 3,000 emails/month free)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
FRONTEND_URL=http://localhost:3000
EMAIL_TEMPLATE_DIR=app/email_templates
EMAIL_THEME_APP_NAME=Messaging Platform
EMAIL_THEME_LOGO_URL=
EMAIL_THEME_PRIMARY_COLOR=#1d4ed8
EMAIL_THEME_ACCENT_COLOR=#0f172a
EMAIL_THEME_SUPPORT_EMAIL=support@example.com
EMAIL_THEME_SUPPORT_URL=
EMAIL_THEME_FOOTER_TEXT=Sent by Messaging Platform
EMAIL_THEME_PRODUCT_URL=http://localhost:3000

# Option 2: SendGrid (Alternative)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Option 3: SMTP (For corporate email)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.company.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@company.com
# SMTP_PASSWORD=your-app-password

# ========================================
# OPTIONAL: SCALING & PRODUCTION FEATURES
# ========================================

# Redis (Optional - enables caching and scaling)
# Install Redis locally or use cloud Redis
# REDIS_URL=redis://localhost:6379/0

# Celery (Optional - enables background task processing)
# Requires Redis or RabbitMQ
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# WebRTC (Optional - for corporate networks with firewalls)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_SERVER_USERNAME=your-username
# TURN_SERVER_CREDENTIAL=your-credential

# ========================================
# DEPLOYMENT SETTINGS
# ========================================

# Environment
ENVIRONMENT=development

# CORS - Allow all for development, restrict for production
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Debug mode
DEBUG=true

# ========================================
# JWT TOKEN SETTINGS (Optional - defaults provided)
# ========================================

# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
# VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ========================================
# MOBILE APP SETTINGS (Optional)
# ========================================

# For mobile app deep linking
# MOBILE_APP_SCHEME=enterprisemessaging
